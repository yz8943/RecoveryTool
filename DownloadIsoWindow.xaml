<Window x:Class="RecoveryTool.DownloadIsoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="准备 Windows 11 安装镜像" Width="980" Height="760" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ResizeMode="CanResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="准备 Windows 11 安装镜像" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A" />
        <TextBlock Grid.Row="1" Text="请从微软官方下载 ISO 文件。下载完成后返回此窗口并选择本地镜像。" Margin="0,8,0,18" Foreground="#64748B" FontSize="14" />

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Image Source="/Assets/windows11-iso-download.png" Stretch="Uniform" MaxWidth="900" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="打开微软官方下载页面" Click="OpenDownloadPage_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" />
                <TextBlock Text="https://www.microsoft.com/zh-cn/software-download/windows11" VerticalAlignment="Center" Foreground="#2563EB" Margin="0,0,18,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click" />
                <Button Content="我已下载，选择 ISO" Click="ContinueButton_Click" Background="#0F766E" Foreground="White" BorderBrush="#0F766E" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
