<Window x:Class="RecoveryTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公司电脑恢复工具" Width="820" Height="570" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="公司电脑恢复工具" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="RecoveryTool · 单机版" Margin="0,6,0,0" Foreground="#64748B" FontSize="14" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,28,0,24" Padding="18" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="当前电脑" FontWeight="SemiBold" Foreground="#334155" />
                <TextBlock Text="{Binding ComputerName}" Margin="0,8,0,0" FontSize="18" Foreground="#0F172A" />
                <TextBlock Text="{Binding WindowsVersion}" Margin="0,3,0,0" Foreground="#64748B" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Height="140" Margin="0,0,12,0" Click="ResetButton_Click" Background="White" BorderBrush="#BFDBFE">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="①" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="重置系统" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="删除数据并恢复 Windows" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Height="140" Margin="12,0,0,0" Click="InstallButton_Click" Background="White" BorderBrush="#BFDBFE">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="②" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="安装系统" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="先获取官方 ISO，再开始安装" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,18,0" />
            <Button Content="退出" Click="ExitButton_Click" />
        </StackPanel>
    </Grid>
</Window>
